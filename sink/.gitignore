# 내려받은 원본 대본(저작권 있는 글, 읽기 전용)과 압축 해제본
filmmakers_scripts/
extracted/

# 대본 전문이 든 결과물과 중간 결과(다시 만들 수 있음: python -I -m sinkprep all)
# 다만 cache/llm(claude 응답)은 빈 캐시로 다시 부르면 결과가 조금 달라질 수 있어 data/llm_cache.zip 으로 저장소에 넣고
# (tools/llm_cache_zip.py pack|unpack), 큰 실행 앞뒤 사본은 backup/ 에 둔다
docs/
cache/
logs/
backup/
# 영화별 결과물(받아쓰기 전문 asr.json, 대본 대사가 든 align.json·final.json): 영상이 있어야 다시 만들 수 있다
films/

# 등록한 영상 파일(원본의 하드링크나 사본, python -I -m sinkprep video)
videos/

# 따로 저장소가 있는 하위 프로젝트
vgrab/

# 실행 환경·도구 부산물
.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# oh-my-claudecode 실행 상태(명세 .omc/specs 는 남김)
.omc/*
!.omc/specs/

# 영화 대본 원문(저작물)은 올리지 않는다. 로컬에만 둔다
tests/gold/*.jsonl
tests/fixtures/parse/
