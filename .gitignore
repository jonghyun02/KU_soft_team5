# 내려받은 원본 대본(저작권 있는 글, 읽기 전용)과 압축 해제본
filmmakers_scripts/
extracted/

# 대본 전문이 든 결과물과 중간 결과(다시 만들 수 있음: python -I -m sinkprep all)
# 다만 cache/llm(claude 응답)은 빈 캐시로 다시 부르면 결과가 조금 달라질 수 있어 data/llm_cache.zip 으로 저장소에 넣고
# (tools/llm_cache_zip.py pack|unpack), 큰 실행 앞뒤 사본은 backup/ 에 둔다
docs/
cache/
logs/
backup/

# 따로 저장소가 있는 하위 프로젝트
vgrab/

# 실행 환경·도구 부산물
.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# oh-my-claudecode 실행 상태(명세 .omc/specs 는 남김)
.omc/*
!.omc/specs/
